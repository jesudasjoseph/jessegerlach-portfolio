---
import { WEB3FORMS_ACCESS_KEY } from "astro:env/client";
import Input from "./Input.astro";
---

<script is:inline src="https://web3forms.com/client/script.js" async defer
></script>

<script>
  // Find all buttons with the `alert` class on the page.
  const forms = document.querySelectorAll("form.web3form");

  function handleSubmit(event: Event) {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const formData = new FormData(form);

    const hcaptcha = formData.get("h-captcha-response");

    if (!hcaptcha) {
      //Add form feedback
      return;
    }

    fetch("https://api.web3forms.com/submit", {
      method: "POST",
      body: formData,
    })
      .then((response) => response.json())
      .then((data) => {
        if (!data.success) {
          //Add form submission error
          throw Error("Form submission failed");
        }
      })
      .catch((e) => {
        //Add form submission error
        throw e;
      })
      .finally(() => {
        form.reset();
      });
  }

  // Handle submissions on each form.
  forms.forEach((form) => {
    form.addEventListener("onsubmit", handleSubmit);
  });
</script>

<form class="p-8 web3form">
  <h2 class="mb-8 text-3xl font-bold text-orange-500 text-shadow-lg">
    Send me a message
  </h2>
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />

  <Input label="Name" name="name" type="text" required />
  <Input label="Email" name="email" type="email" required />
  <label for="message" class="sr-only">Message</label>
  <textarea
    name="message"
    id="message"
    placeholder="Message..."
    required
    class="mb-2 h-50 w-full size-fit"></textarea>

  <div class="mb-2 flex flex-col gap-2">
    <div class="h-captcha" data-captcha="true"></div>
  </div>
  <button type="submit" class="btn text-lg">Send Message</button>
</form>
